# Jangan ikut masuk ke image Docker — mengurangi ukuran image dan
# mencegah file sensitif/lokal ter-bundle tanpa sengaja.
.git/
.gitignore
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.env
.env.local
*.pgpass
*.log
*-workspace/
DBeaverData/
screenshots-dbeaver/
screenshot-locustfile-dashboard/
report.html
